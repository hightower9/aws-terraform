# ============================================================
# Environment variables used by this repo.
# Copy to `.env` (gitignored) and adjust. The Makefile loads `.env`
# automatically when present: `make plan ENV=dev` etc.
# ============================================================

# ---- AWS credentials / profile (used for dev/uat/prod + CI) ----
# The Makefile auto-detects the account ID from these, so `make plan ENV=dev`
# works with zero extra setup as long as your AWS CLI is authenticated.
AWS_PROFILE=default
AWS_REGION=us-east-1

# Optional: force the Terraform AWS-provider region if not the default above.
TF_VAR_aws_region=us-east-1

# ---- Logging ----
# SET_AWS_CONFIG_PATH to 1 to debug provider auth; TRACE = everything.
# Valid levels: TRACE, DEBUG, INFO, WARN, ERROR
TF_LOG=
# Write logs to a file instead of stdout (keeps plan output readable).
# TF_LOG_PATH=terraform.log

# ---- Local emulator (Floci) ----
# No variables needed: `make ... EMULATOR=1` (and ENV=local) injects the
# Floci endpoint + test credentials per command. Do NOT set AWS_ENDPOINT_URL
# here, or real-AWS runs of dev/uat/prod would be sent to the emulator.
